# NetMoniAI Environment Configuration Example
# Copy this file to .env and fill in your values

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# OpenCode / OpenAI-Compatible Endpoint (Optional)
# e.g., Ollama: http://localhost:11434/v1 | vLLM: http://localhost:8000/v1 | OpenRouter: https://openrouter.ai/api/v1
OPENCODE_API_KEY=opencode-token
OPENCODE_BASE_URL=http://localhost:11434/v1

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
